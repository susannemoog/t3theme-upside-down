mod.web_layout.BackendLayouts {
  UpsideContentpage {
    title = LLL:EXT:theme_upside_down/Resources/Private/Language/backend_layouts.xlf:backend_layout.upside_contentpage.title
    config {
      backend_layout {
        colCount = 3
        rowCount = 3
        rows {
          1 {
            columns {
              1 {
                name = LLL:EXT:theme_upside_down/Resources/Private/Language/backend_layouts.xlf:backend_layout.colpos.stage
                colPos = 2
                colspan = 3
                identifier = stage
              }
            }
          }
          2 {
            columns {
              1 {
                name = LLL:EXT:theme_upside_down/Resources/Private/Language/backend_layouts.xlf:backend_layout.colpos.main
                colPos = 0
                colspan = 2
                identifier = main
              }
              2 {
                name = LLL:EXT:theme_upside_down/Resources/Private/Language/backend_layouts.xlf:backend_layout.colpos.signal
                colPos = 20
                identifier = signal
                allowedContentTypes = upside_storybeat,text,textmedia,textpic
              }
            }
          }
          3 {
            columns {
              1 {
                name = LLL:EXT:theme_upside_down/Resources/Private/Language/backend_layouts.xlf:backend_layout.colpos.footer
                colPos = 10
                colspan = 3
                identifier = footer
                slideMode = slide
              }
            }
          }
        }
      }
    }
  }
}
