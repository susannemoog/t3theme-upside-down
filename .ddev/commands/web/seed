#!/usr/bin/env bash

## Description: Seed or reset Upside Down theme demo content
## Usage: seed [--force]
## Example: "ddev seed\nddev seed --force"

set -euo pipefail

source /var/www/html/.ddev/scripts/functions.sh

SQL_FILE="${PROJECT_ROOT}/Resources/Private/Sql/upside-down-demo-content.sql"

if [ ! -f "${SQL_FILE}" ]; then
    error "Seed file not found: ${SQL_FILE}"
    exit 1
fi

# Guard against accidental overwrites unless --force is passed
if [ "${1:-}" != "--force" ]; then
    page_count=$(mysql -udb -pdb db -sN -e "SELECT COUNT(*) FROM pages;" 2>/dev/null || echo "0")
    if [ "${page_count}" -gt 0 ]; then
        warn "Database already contains ${page_count} page(s)."
        echo ""
        echo "  Run with --force to overwrite existing content:"
        echo "    ddev seed --force"
        echo ""
        exit 0
    fi
fi

MEDIA_SRC="${PROJECT_ROOT}/Resources/Public/Media"
FILEADMIN_DEST="${PROJECT_ROOT}/Build/public/fileadmin/upside-down"

echo ""
echo -e "${BOLD}Upside Down — Demo Content Seed${NC}"
echo "═══════════════════════════════════════"
echo ""

info "[1/4] Copying media assets to fileadmin..."
mkdir -p "${FILEADMIN_DEST}"
for f in lab-interior.svg gate-rift.svg radio-scan.svg bike-night.svg demogorgon-silhouette.svg evidence-board.svg; do
    cp "${MEDIA_SRC}/${f}" "${FILEADMIN_DEST}/${f}"
done
success "Media assets copied to fileadmin/upside-down/"

info "[2/4] Setting up extensions (creates any new DB columns)..."
vendor/bin/typo3 extension:setup 2>/dev/null || warn "extension:setup had warnings"

info "[3/4] Importing demo content..."
if ! mysql -udb -pdb db < "${SQL_FILE}"; then
    error "SQL import failed"
    exit 1
fi
success "Pages and content elements seeded"

info "[4/4] Flushing caches..."
vendor/bin/typo3 cache:flush 2>/dev/null || warn "cache:flush had warnings"
success "Caches flushed"

echo ""
echo "═══════════════════════════════════════"
success "Demo content ready!"
echo ""
echo -e "  ${BOLD}Site:${NC}     ${DDEV_PRIMARY_URL}"
echo -e "  ${BOLD}Backend:${NC}  ${DDEV_PRIMARY_URL}/typo3/"
echo ""
echo -e "  ${BOLD}Pages seeded:${NC}"
echo "    /                     Landing page"
echo "    /hawkins-field-guide  Hawkins Field Guide"
echo "    /survival-kit         Survival Kit"
echo "    /strange-questions    Strange Questions"
echo "    /imprint              Imprint (nav hidden)"
echo "    /privacy              Privacy  (nav hidden)"
echo ""
